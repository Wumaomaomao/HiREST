[
    {
        "op_name": "post /check",
        "type": "string",
        "param_name": "text",
        "format": [
            "^[\\s\\S]*$"
        ],
        "valid": [
            {
                "param_name": "text",
                "category": "Non-empty text",
                "description": "A non-empty string of text to be checked.",
                "samples": [
                    "This is a sample text.",
                    "Hello, world!",
                    "The quick brown fox jumps over the lazy dog.",
                    "Lorem ipsum dolor sit amet.",
                    "Grammar checking is important.",
                    "Proofreading helps improve writing."
                ]
            },
            {
                "param_name": "text",
                "category": "Long text",
                "description": "A longer string of text to be checked.",
                "samples": [
                    "Once upon a time, in a land far, far away, there lived a king who ruled with wisdom and kindness.",
                    "In the midst of the bustling city, there was a small, quaint café that served the best coffee in town.",
                    "The sun set over the horizon, painting the sky in hues of orange and pink, as the day came to a peaceful end.",
                    "As the rain poured down, the streets glistened with reflections of the city lights, creating a mesmerizing scene.",
                    "The library was a haven of knowledge, filled with books that transported readers to different worlds and times.",
                    "With each passing season, the garden bloomed with vibrant colors, a testament to the beauty of nature."
                ]
            },
            {
                "param_name": "text",
                "category": "Text with special characters",
                "description": "A string of text containing special characters.",
                "samples": [
                    "Hello, world! @#&*()",
                    "Check this: $%^&*()_+",
                    "Special characters: ~`<>?",
                    "Symbols: []{}|\\",
                    "Punctuation: ;:'\",./",
                    "Mix: !@#$%^&*()_+"
                ]
            }
        ],
        "invalid": [
            {
                "param_name": "text",
                "category": "Empty string",
                "description": "An empty string input.",
                "samples": [
                    ""
                ]
            },
            {
                "param_name": "text",
                "category": "Non-string input",
                "description": "Input that is not a string.",
                "samples": [
                    123,
                    true,
                    null,
                    [],
                    {},
                    45.67
                ]
            }
        ]
    },
