[
    {
        "op_name": "post /check",
        "type": "string",
        "param_name": "text",
        "format": [],
        "valid": [
            {
                "param_name": "text",
                "category": "Plain text sentences",
                "description": "Simple human-readable sentences without special formatting.",
                "samples": [
                    "Hello world.",
                    "This is a test.",
                    "Please check this text.",
                    "We are testing the checker.",
                    "I have a pen.",
                    "The weather is nice today."
                ]
            },
            {
                "param_name": "text",
                "category": "Text with punctuation and numbers",
                "description": "Text containing punctuation, numbers, or symbols that may trigger grammar/style checks.",
                "samples": [
                    "Version 2.0 released!",
                    "Is this okay?",
                    "In 2020, we moved.",
                    "Call me at 555-1234.",
                    "Price is $5.99.",
                    "Wait... what?!"
                ]
            },
            {
                "param_name": "text",
                "category": "<MISS_KEY>",
                "description": "text omitted; when 'data' is provided this is normal.",
                "samples": [
                    null,
                    null,
                    null,
                    null,
                    null,
                    null
                ]
            }
        ],
        "invalid": [
            {
                "param_name": "text",
                "category": "Empty or whitespace-only",
                "description": "Empty strings or strings that only contain whitespace/control whitespace.",
                "samples": [
                    "",
                    " ",
                    "   ",
                    "\t",
                    "\n",
                    "\r\n"
                ]
            },
            {
                "param_name": "text",
                "category": "Non-string type",
                "description": "Values that are not strings.",
                "samples": [
                    123,
                    true,
                    false,
                    null,
                    [],
                    {}
                ]
            },
            {
                "param_name": "text",
                "category": "Strings with control characters",
                "description": "Strings containing non-printable control characters.",
                "samples": [
                    "\u0000",
                    "A\u0000B",
                    "Line\u0007",
                    "Text\b",
                    "\u001bescape",
                    "\u0001"
                ]
            }
        ]
    },
    {
        "op_name": "post /check",
        "type": "string",
        "param_name": "data",
        "format": [
            "JSON string: {\"annotation\":[{\"text\":\"...\"}|{\"markup\":\"...\"}(, ...)]}"
        ],
        "valid": [
            {
                "param_name": "data",
                "category": "Minimal text-only annotation JSON",
                "description": "JSON with 'annotation' array and text items only.",
                "samples": [
                    "{\"annotation\":[{\"text\":\"Hi\"}]}",
                    "{\"annotation\":[{\"text\":\"Hello\"}]}",
                    "{\"annotation\":[{\"text\":\"Test\"}]}",
                    "{\"annotation\":[{\"text\":\"A\"}]}",
                    "{\"annotation\":[{\"text\":\"OK\"}]}",
                    "{\"annotation\":[{\"text\":\"Yes\"}]}"
                ]
            },
            {
                "param_name": "data",
                "category": "Mixed text and markup annotation JSON",
                "description": "JSON mixing markup and text; markup will be ignored for checking.",
                "samples": [
                    "{\"annotation\":[{\"markup\":\"<b>\"},{\"text\":\"A\"},{\"markup\":\"</b>\"}]}",
                    "{\"annotation\":[{\"markup\":\"<i>\"},{\"text\":\"x\"},{\"markup\":\"</i>\"}]}",
                    "{\"annotation\":[{\"markup\":\"<p>\"},{\"text\":\"T\"}]}",
                    "{\"annotation\":[{\"text\":\"a\"},{\"markup\":\"<br>\"},{\"text\":\"b\"}]}",
                    "{\"annotation\":[{\"markup\":\"<u>\"},{\"text\":\"U\"}]}",
                    "{\"annotation\":[{\"markup\":\"<em>\"},{\"text\":\"e\"},{\"markup\":\"</em>\"}]}"
                ]
            },
            {
                "param_name": "data",
                "category": "<MISS_KEY>",
                "description": "data omitted; when 'text' is provided this is normal.",
                "samples": [
                    null,
                    null,
                    null,
                    null,
                    null,
                    null
                ]
            }
        ],
        "invalid": [
            {
                "param_name": "data",
                "category": "Not JSON / plain text",
                "description": "Values that are not valid JSON strings for the 'data' schema.",
                "samples": [
                    "A test",
                    "<b>test</b>",
                    "{not json}",
                    "",
                    " ",
                    "\n"
                ]
            },
            {
                "param_name": "data",
                "category": "JSON with wrong structure",
                "description": "JSON that lacks 'annotation' array or has invalid items.",
                "samples": [
                    "{\"text\":\"A\"}",
                    "{\"annotation\":{}}",
                    "{\"annotation\":[{}]}",
                    "{\"annotation\":[{\"foo\":\"bar\"}]}",
                    "{\"ann\":[{\"text\":\"A\"}]}",
                    "{\"annotation\":[]}"
                ]
            },
            {
                "param_name": "data",
                "category": "Non-string type",
                "description": "Values of wrong type for 'data'.",
                "samples": [
                    123,
                    true,
                    false,
                    null,
                    [],
                    {}
                ]
            }
        ]
    },
    {
        "op_name": "post /check",
        "type": "string",
        "param_name": "language",
        "format": [
            "^[a-z]{2,3}(-[A-Z]{2})?$|^auto$"
        ],
        "valid": [
            {
                "param_name": "language",
                "category": "Language codes with variants",
                "description": "Languages that require variant specification for spell checking (e.g., English, German, Portuguese).",
                "samples": [
                    "en-GB",
                    "en-US",
                    "de-DE",
                    "de-AT",
                    "pt-BR",
                    "pt-PT"
                ]
            },
            {
                "param_name": "language",
                "category": "Generic language codes",
                "description": "Language codes without variants (spell checking may be limited for languages that have variants).",
                "samples": [
                    "fr",
                    "es",
                    "it",
                    "nl",
                    "sv",
                    "pl"
                ]
            },
            {
                "param_name": "language",
                "category": "Automatic language detection",
                "description": "Use 'auto' to let the server detect the language.",
                "samples": [
                    "auto",
                    "auto",
                    "auto",
                    "auto",
                    "auto",
                    "auto"
                ]
            }
        ],
        "invalid": [
            {
                "param_name": "language",
                "category": "Malformed language codes",
                "description": "Wrong case or separators.",
                "samples": [
                    "EN",
                    "english",
                    "en_gb",
                    "enGB",
                    "de-de",
                    "e-n"
                ]
            },
            {
                "param_name": "language",
                "category": "Unknown or unsupported codes",
                "description": "Codes that do not represent known languages or variants.",
                "samples": [
                    "xx-YY",
                    "zz",
                    "en-UK",
                    "pt-MX",
                    "de-XY",
                    "abc"
                ]
            },
            {
                "param_name": "language",
                "category": "Empty or whitespace",
                "description": "Missing or blank string values.",
                "samples": [
                    "",
                    " ",
                    "\n",
                    "\t",
                    "  ",
                    "\r"
                ]
            },
            {
                "param_name": "language",
                "category": "<MISS_KEY>",
                "description": "language omitted; this required parameter is missing.",
                "samples": [
                    null,
                    null,
                    null,
                    null,
                    null,
                    null
                ]
            }
        ]
    },
